#!/bin/sh
# Pre-push hook: push の前にテスト全部と生成物の食い違い検査を流す（node _work/run_all.js・約15〜30秒）。
# 落ちたら push を止める。
#
# ⚠️ 見ているのは作業ツリー（コミットしていない変更も含む）。push するのはコミット済みの中身なので、
#    未コミットの変更で「たまたま合格」していないかは git status で確かめること。
# 急ぎで飛ばすとき: git push --no-verify（GitHub Actions が push 後にも同じ検査を流す）
#
# このフックは Git 管理下（_work/hooks/）にある。有効にするには一度だけ:
#   git config core.hooksPath _work/hooks

echo "[pre-push] node _work/run_all.js ..."
if ! node _work/run_all.js; then
  echo ""
  echo "[pre-push] 上の失敗を直してから push してください。"
  echo "  To skip: git push --no-verify"
  exit 1
fi
exit 0
